<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.cegepvicto.dimhortons.Authentification.AuthentificationController"
            stylesheets="@/edu/cegepvicto/dimhortons/styles.css"
            id="conteneur-racine"
            minHeight="600"
            minWidth="550">

    <!-- barre top -->
    <top>
        <HBox id="barre-entete" styleClass="barre-entete">
            <Button fx:id="boutonRetourMenu"
                    styleClass="bouton-retour"
                    text="←"
                    onAction="#onRetourAccueil"/>
        </HBox>
    </top>

    <!-- Contenu principal -->
    <center>
        <VBox id="conteneur-principal"
              styleClass="conteneur-principal"
              spacing="20"
              alignment="CENTER">

            <!-- Titre -->
            <Label id="titre-connexion"
                   text="Connexion à DimHorton"
                   style="-fx-font-size:20px; -fx-font-weight:bold;"/>

            <!-- Formulaire -->
            <GridPane id="formulaire-connexion"
                      hgap="10" vgap="10" maxWidth="360">

                <columnConstraints>
                    <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Email :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="emailField"
                           promptText="ex: toto@example.com"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Mot de passe :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <PasswordField fx:id="champMotDePasse"
                               promptText="Votre mot de passe"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>
            <HBox id="zone-bouton-connexion"
                  spacing="10"
                  maxWidth="360"
                  alignment="CENTER_RIGHT">

                <!-- Message erreur -->
                <Label fx:id="labelErreur"
                       id="label-erreur"
                       textFill="red"
                       wrapText="true"
                       maxWidth="360"/>

                <!-- Bouton Connexion -->
                <Button text="Connexion"
                        styleClass="bouton-connexion"
                        defaultButton="true"
                        onAction="#onAuthentification"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
