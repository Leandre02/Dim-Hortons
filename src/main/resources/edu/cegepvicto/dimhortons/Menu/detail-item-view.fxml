<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.cegepvicto.dimhortons.Menu.DetailItemController"
            styleClass="root" stylesheets="@/edu/cegepvicto/dimhortons/styles.css">

    <!-- EN-TÊTE -->
    <top>
        <HBox styleClass="barre-entete" spacing="15" alignment="CENTER_LEFT">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Button fx:id="boutonRetour" styleClass="bouton-retour" text="←" onAction="#retourMenu"/>
            <Label styleClass="logo-titre" text="Dim Hortons" HBox.hgrow="ALWAYS"/>
            <Button styleClass="bouton-connexion" text="Connexion"/>
        </HBox>
    </top>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="zone-items">
            <VBox alignment="TOP_CENTER" spacing="20" styleClass="conteneur-detail">
                <padding>
                    <Insets top="30" right="20" bottom="30" left="20"/>
                </padding>

                <!-- IMAGE DU PRODUIT -->
                <ImageView fx:id="imageItem" fitWidth="400" fitHeight="400" preserveRatio="true"/>

                <!-- NOM DU PRODUIT -->
                <Label fx:id="nomItem" styleClass="nom-produit" wrapText="true" textAlignment="CENTER"/>

                <!-- PRIX -->
                <Label fx:id="prixItem" styleClass="prix-produit"/>

                <!-- DESCRIPTION -->
                <Label fx:id="descriptionItem" styleClass="description-produit" wrapText="true" textAlignment="CENTER" maxWidth="600"/>

                <!-- SECTION INFORMATION -->
                <VBox spacing="10" styleClass="section-info" maxWidth="600">
                    <Label text="Information" styleClass="titre-section"/>
                    <Label fx:id="informationItem" styleClass="texte-info" wrapText="true"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- BARRE DU BAS AVEC QUANTITÉ ET BOUTON AJOUTER -->
    <bottom>
        <HBox styleClass="barre-ajout" spacing="15" alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Contrôles de quantité -->
            <HBox spacing="15" alignment="CENTER" styleClass="conteneur-quantite">
                <Button fx:id="boutonMoins" text="−" styleClass="bouton-quantite" onAction="#diminuerQuantite"/>
                <Label fx:id="quantiteLabel" text="1" styleClass="quantite-label"/>
                <Button fx:id="boutonPlus" text="+" styleClass="bouton-quantite" onAction="#augmenterQuantite"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Bouton ajouter au panier -->
            <Button fx:id="boutonAjouter" styleClass="bouton-ajouter-panier" onAction="#ajouterAuPanier">
                <graphic>
                    <HBox spacing="10" alignment="CENTER">
                        <Label text="Ajouter — "/>
                        <Label fx:id="prixTotalLabel" text="12,00 $"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>
    </bottom>

</BorderPane>
