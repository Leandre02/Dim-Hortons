<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.cegepvicto.dimhortons.Menu.MenuController"
            stylesheets="@/edu/cegepvicto/dimhortons/styles.css"
            id="conteneur-racine">

    <top>
        <HBox id="barre-entete" styleClass="barre-entete">
            <Button id="bouton-retour" styleClass="bouton-retour" text="←"/>
            <Label id="logo-titre" styleClass="logo-titre" text="Dim Hortons"/>
            <Button fx:id="boutonConnexion" styleClass="bouton-connexion" text="Connexion" onAction="#onBoutonConnexion"/>
            <Label fx:id="labelNom" styleClass="label-nom"/>
            <Button fx:id="boutonAdmin" styleClass="bouton-connexion" text="Menu Admin" visible="false" onAction="#onBoutonAdmin"/>
        </HBox>
    </top>

    <center>
        <VBox id="conteneur-principal" styleClass="conteneur-principal">

            <HBox fx:id="barreCategorie" id="barre-categories" styleClass="barre-categories">
                <Button styleClass="categorie-btn" text="Tous"/>
                <Button styleClass="categorie-btn" text="Cafés"/>
                <Button styleClass="categorie-btn" text="Beignes"/>
                <Button styleClass="categorie-btn" text="Sandwichs"/>
            </HBox>

            <ScrollPane id="zone-items" styleClass="zone-items" fitToWidth="true">
                <VBox id="liste-menu" fx:id="listeMenu" styleClass="liste-menu">
                    <!-- Les items seront ajoutés ici dynamiquement -->
                </VBox>
            </ScrollPane>

        </VBox>
    </center>

    <bottom>
        <HBox id="barre-panier" styleClass="barre-panier">
            <Label styleClass="icone-panier" text="🛒"/>
            <Label id="compteur-panier" fx:id="compteurPanier" styleClass="compteur-panier" text="0"/>
            <Label styleClass="texte-panier" text="articles"/>
            <Button id="bouton-voir-panier" fx:id="boutonVoirPanier" styleClass="bouton-voir-panier" text="Voir le panier"/>
            <Button id="payer" fx:id="payer" styleClass="payer" text="Passer au paiement" onAction="#onBoutonPaiement"/>

        </HBox>
    </bottom>

</BorderPane>