<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.cegepvicto.dimhortons.Menu.PanierController"
            stylesheets="@/edu/cegepvicto/dimhortons/styles.css"
            styleClass="conteneur-principal">

    <!-- En-tête panier -->
    <top>
        <HBox spacing="10"
              alignment="CENTER_LEFT"
              styleClass="barre-entete">
            <children>
                <Label text="Votre panier"
                       styleClass="topbar-title"/>
            </children>
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </HBox>
    </top>

    <!-- Liste des items du panier -->
    <center>
        <ListView fx:id="listViewPanier"
                  BorderPane.alignment="CENTER"/>
    </center>

    <!-- Barre d'action du panier -->
    <bottom>
        <HBox spacing="10"
              alignment="CENTER_RIGHT"
              styleClass="barre-panier">
            <children>
                <Button text="Fermer"
                        onAction="#handleFermer"
                        styleClass="bouton-action-panier"/>

                <Button text="Modifier l'item"
                        onAction="#handleModifier"
                        styleClass="bouton-action-panier"/>

            </children>
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </HBox>
    </bottom>

</BorderPane>