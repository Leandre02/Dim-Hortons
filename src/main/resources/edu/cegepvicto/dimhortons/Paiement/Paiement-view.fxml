<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.cegepvicto.dimhortons.Paiement.PaiementController"
            stylesheets="@/edu/cegepvicto/dimhortons/styles.css"
            id="conteneur-racine">

    <top>
        <HBox id="barre-entete" styleClass="barre-entete" spacing="10">
            <Button fx:id="boutonRetour" text="←" styleClass="bouton-retour" onAction="#onRetourMenu"/>
            <Label text="Paiement" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
        </HBox>
    </top>

    <center>
        <VBox id="conteneur-principal" styleClass="conteneur-principal" spacing="20" alignment="CENTER">
            <Label text="Votre panier" style="-fx-font-size:16px; -fx-font-weight:bold;"/>
            <ListView fx:id="listViewPanier" prefHeight="400"/>
            <Label fx:id="labelTotal" text="Total : 0 $" style="-fx-font-size:14px; -fx-font-weight:bold;"/>
        </VBox>
    </center>

    <bottom>
        <HBox id="zone-bouton-paiement" spacing="10" alignment="CENTER_RIGHT" styleClass="barre-panier">
            <Button text="Retour" styleClass="ghost" onAction="#onRetourMenu"/>
            <Button fx:id="boutonPayer" text="Payer" styleClass="bouton-connexion" onAction="#onPayer"/>
        </HBox>
    </bottom>

</BorderPane>
